# Root helper file.
# The frontend and backend each load their own env files in local development.
# Copy the relevant values into frontend/.env.local and backend/.env.

# Frontend / Next.js
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
AGENT_URL=http://localhost:8000
AGENT_INTERNAL_TOKEN=change-me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend / FastAPI agent
SUPABASE_URL=https://xxxx.supabase.co
AGENT_INTERNAL_TOKEN=change-me
AI_PROVIDER=openai
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VECTOR_STORES_ENABLED=true
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=isimple-agent
