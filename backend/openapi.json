    },
    "/api/documents/index": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Index Document Route",
        "operationId": "index_document",
        "parameters": [
          {
            "name": "X-Agent-Token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Agent-Token"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DocumentIndexRequest"
              }
