      }
    },
    "/api/documents/search": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Search Documents Route",
        "operationId": "search_documents",
        "parameters": [
          {
            "name": "X-Agent-Token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
