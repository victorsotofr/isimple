NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only values used by Next.js route handlers.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
AGENT_URL=http://localhost:8000
AGENT_INTERNAL_TOKEN=change-me

NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Gmail OAuth for manager mailbox intake.
# Redirect URI must be registered in Google Cloud OAuth client.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_GMAIL_REDIRECT_URI=https://your-domain.example/api/gmail/callback
GMAIL_TOKEN_ENCRYPTION_KEY=base64-32-byte-key
